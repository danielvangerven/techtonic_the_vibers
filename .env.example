# Copy to .env and fill in. Never commit .env.

# Session cookie signing secret, at least 32 random characters
SESSION_SECRET=

# Gemini via Vertex AI (Google Gen AI SDK)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west1
# Path to a service-account key OUTSIDE the repo, or use `gcloud auth application-default login`
GOOGLE_APPLICATION_CREDENTIALS=
# The current Flash model on Vertex AI
GEMINI_MODEL=gemini-2.5-flash
# "keywords" skips Gemini entirely (demo fallback). Empty = Gemini when GOOGLE_CLOUD_PROJECT is set.
CLASSIFIER=

# Optional: fixed "today" (YYYY-MM-DD) so the recorded demo always shows the same moments
DEMO_TODAY=2026-09-30

# Optional: voice briefing
ELEVENLABS_API_KEY=

# Optional: fixed voice for the briefing
ELEVENLABS_VOICE_ID=
